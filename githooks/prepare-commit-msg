#!/bin/sh
# Auto Co-authored-by: Hermes Agent (model) <noreply@nousresearch.com>
#
# Author always stays canonical: Andrew Breckenridge <asbreckenridge@me.com>.
# The trailer marks provenance only — it never changes commit authorship.
#
# Gate (first match wins):
#   HERMES_NO_COAUTHOR=1   → never attribute (escape hatch for hand-typed
#                            commits inside an agent session)
#   HERMES_AGENT_COMMIT=1  → attribute (explicit; the reliable path, works on
#                            every platform including CLI/Telegram/cron)
#   HERMES_SESSION_ID set  → attribute (ambient; currently only exported by the
#                            WebUI path in hermes-webui/api/streaming.py)
#   otherwise              → no-op
#
# Deliberately NOT gated on HERMES_HOME: that names the active profile dir and
# is exported by the gateway itself, so it is true in plain shells the human
# drives. It is not an authorship signal.

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Chain to a repo-local hook, if one exists and is not this script.
# core.hooksPath=~/.githooks means git skips .git/hooks entirely, so repos that
# install their own hook (husky, pre-commit, lefthook) need an explicit call.
chain_local_hook() {
  hooks_dir=$(git rev-parse --git-path hooks 2>/dev/null) || return 0
  [ -n "$hooks_dir" ] || return 0
  local_hook="${hooks_dir}/prepare-commit-msg"
  [ -x "$local_hook" ] || return 0

  # Never re-enter ourselves.
  self=$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")
  other=$(cd "$(dirname "$local_hook")" 2>/dev/null && pwd)/$(basename "$local_hook")
  [ "$self" = "$other" ] && return 0

  "$local_hook" "$@"
}

should_attribute() {
  [ "$HERMES_NO_COAUTHOR" = "1" ] && return 1
  [ "$HERMES_AGENT_COMMIT" = "1" ] && return 0
  [ -n "$HERMES_SESSION_ID" ] && return 0
  return 1
}

if ! should_attribute; then
  chain_local_hook "$@"
  exit 0
fi

case "$COMMIT_SOURCE" in
  merge|squash) chain_local_hook "$@"; exit 0 ;;
esac

# Idempotent: amends and rebases re-run this hook on an existing message.
if grep -qi "^Co-authored-by:.*Hermes" "$COMMIT_MSG_FILE"; then
  chain_local_hook "$@"
  exit 0
fi

# Skip empty messages — git aborts the commit anyway, and a lone trailer would
# make the message look non-empty enough to go through.
MSG_CONTENT=$(grep -v "^#" "$COMMIT_MSG_FILE" | grep -v "^[[:space:]]*$" | head -n 20)
if [ -z "$MSG_CONTENT" ]; then
  chain_local_hook "$@"
  exit 0
fi

MODEL=""
CONFIG="${HERMES_HOME:-$HOME/.hermes}/config.yaml"
if [ -f "$CONFIG" ]; then
  MODEL=$(awk '/^model:/{p=1;next} /^[^[:space:]]/{p=0} p && /default:/{print $2; exit}' \
    "$CONFIG" | tr -d "\"'")
fi

if [ -n "$MODEL" ]; then
  DISPLAY="Hermes Agent ($MODEL)"
else
  DISPLAY="Hermes Agent"
fi

# Nous controls nousresearch.com, so this address can't be squatted via GitHub
# email verification. Renders as an unlinked grey name until they claim it.
COAUTHOR="Co-authored-by: $DISPLAY <noreply@nousresearch.com>"

# Trailers need a blank line before the block.
if [ -n "$(tail -n1 "$COMMIT_MSG_FILE")" ]; then
  echo "" >> "$COMMIT_MSG_FILE"
fi
echo "$COAUTHOR" >> "$COMMIT_MSG_FILE"

chain_local_hook "$@"
