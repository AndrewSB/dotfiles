[user]
	name = Andrew Breckenridge
	email = asbreckenridge@me.com
[column]
	ui = auto
[branch]
        sort = -committerdate
[tag]
        sort = version:refname
[diff]
        algorithm = histogram
        colorMoved = plain
        mnemonicPrefix = true
        renames = true
[core]
	whitespace = warn
	excludesfile = ~/.global_gitignore
        hooksPath = ~/.githooks
[credential]
	helper = osxkeychain
[alias]
	l = log --oneline --decorate --graph
	d = diff
[pull]
	ff = only
	rebase = true
[push]
        default = simple
        autoSetupRemote = true
        followTags = true
[fetch]
        prune = true
        pruneTags = true
        all = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[help]
        autocorrect = prompt
[rebase]
        autoSquash = true
        autoStash = true
        updateRefs = true
[merge]
	conflictstyle = zdiff3

[http "https://git.c2p.facebook.net"]
  sslCert = /var/facebook/credentials/asb/x509/asb.pem
# Local overrides (not in repo) - e.g. ~/.config/git/box-config for linux box
# Git ignores missing include files, so safe on mac where box-config doesn't exist
[include]
	path = ~/.config/git/box-config
	path = ~/.gitconfig.local

